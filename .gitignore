# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment — never commit real keys
.env
.env.local
.env.*.local

# Supabase local dev
supabase/.branches
supabase/.temp

# Claude Code personal settings (machine-local; may contain local secrets)
.claude/settings.local.json

# Desktop scaffolding — project targets web + Android, regenerate with `flutter create . --platforms=windows` if ever needed
/windows/

# Flutter DevTools extension settings (local only for now)
devtools_options.yaml
